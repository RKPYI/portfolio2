# --- GitHub OAuth App (create at https://github.com/settings/developers) ---
GITHUB_ID=
GITHUB_SECRET=

# --- NextAuth ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
# Local dev: http://localhost:3000  |  Production: https://your-project.vercel.app
NEXTAUTH_URL=http://localhost:3000

# --- The repo that stores your editable content (data/portfolio.json) ---
GITHUB_REPO_OWNER=your-github-username
GITHUB_REPO_NAME=your-repo-name
GITHUB_BRANCH=main

# --- Only this GitHub username is allowed to edit the site ---
OWNER_GITHUB_USERNAME=your-github-username

# --- Optional: a fine-grained PAT (contents: read-only) to raise the
# GitHub API read-rate-limit from 60/hr to 5000/hr. Not required to run. ---
GITHUB_READ_TOKEN=
